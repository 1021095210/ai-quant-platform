APP_ENV=production
APP_NAME=AI Quant Platform API
APP_PUBLIC_URL=https://quant.example.com
APP_PORT=8000
API_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://user:password@db.example.com:5432/quant_ai
MARKET_DATA_DATABASE_PATH=/app/data/market_data.db
MARKET_DATA_PROVIDER=auto
TUSHARE_TOKEN=

REDIS_URL=redis://:password@redis.example.com:6379/0
REDIS_PASSWORD=quant_redis_pass

MINIO_ENDPOINT=https://minio.example.com
MINIO_CONSOLE=https://minio-console.example.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=quant-platform

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_STRATEGY=gpt-4.1
LLM_MODEL_SUMMARY=gpt-4.1-mini
ALLOWED_LLM_EXPORT_FIELDS=symbol,side,entry_time,exit_time,pnl,feature_snapshot

BACKTEST_ENGINE_VERSION=engine_v1
STRATEGY_PROMPT_VERSION=v1
REPLAY_PROMPT_VERSION=v1
JOB_EXECUTION_MODE=background
JOB_SIMULATION_LATENCY_MS=100

POSTGRES_DB=quant_ai
POSTGRES_USER=quant_user
POSTGRES_PASSWORD=quant_pass
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
